# --- Core ---
PANEL_DOMAIN=panel.example.com
PANEL_INSTANCE_ID=                # wird von install.sh generiert (uuid)

# --- Database ---
POSTGRES_USER=vcp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vcp
DATABASE_URL=postgresql://vcp:change-me@postgres:5432/vcp

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=change-me-64-bytes
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- Initial Admin (nur beim ersten Start verwendet) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- mTLS CA (Pfade im Backend-Container, von install.sh erzeugt) ---
VCP_CA_CERT=/certs/ca.crt
VCP_CA_KEY=/certs/ca.key
VCP_CLIENT_CERT=/certs/panel-client.crt
VCP_CLIENT_KEY=/certs/panel-client.key

# --- External License API (separates System, nur Client) ---
LICENSE_API_URL=https://license.example.com
LICENSE_PUBLIC_KEY=               # base64 Ed25519 public key des License-Servers
LICENSE_KEY=                      # optional: per UI aktivierbar
LICENSE_VALIDATE_INTERVAL_HOURS=6
